# Required: absolute host path to a compatible, locally available checkpoint.
QWEN38_MODEL_PATH=/srv/models/qwen38-flash-next-nvfp4

# Image produced by scripts/build_image.sh.
QWEN38_IMAGE=qwen38-flash-next-sm120:2026-08-31
QWEN38_CONTAINER_NAME=qwen38-flash-next
QWEN38_SERVED_MODEL_NAME=qwen3.8-flash-next-sglang

# Loopback-only by default. Put an authenticated proxy in front before any
# network exposure.
QWEN38_BIND_HOST=127.0.0.1
QWEN38_HOST_PORT=11438
QWEN38_CONTAINER_PORT=11437

# Single-GPU accepted profile.
QWEN38_GPU_DEVICE=0
QWEN38_CPU_SET=0-31
QWEN38_KERNEL_CACHE=/var/lib/qwen38-flash-next/kernel-cache
QWEN38_CONTEXT_LENGTH=131072
QWEN38_MAX_TOTAL_TOKENS=131072
QWEN38_MEM_FRACTION_STATIC=0.96

# Optional exact-image assertion from `docker image inspect --format '{{.Id}}'`.
# QWEN38_IMAGE_ID=sha256:...

# Public verification defaults.
QWEN38_BASE_URL=http://127.0.0.1:11438
QWEN38_READY_TIMEOUT=1800
